# Gradle
.gradle/
# Rooted on purpose. A bare "build/" matches a directory of that name at ANY
# depth, which silently swallowed tools/frontdoor/build/ - so the front door's
# jar and icon have never reached GitHub and anyone cloning got a door they
# could not open without a JDK. See docs/FRONT_DOOR.md; that tool is outside
# the Gradle parts list and its artifact is committed deliberately.
/build/

# The front door's loose class files are output; its jar and icon are not.
tools/frontdoor/build/classes/

# Loom's decompiled/remapped caches and the generated run directory
.fabric/
run/

# IDE
.idea/
*.iml
.vscode/

# Eclipse, and everything the Java language server (JDT.LS) generates on its
# own. Merely opening this project with jdtls creates .factorypath and bin/,
# so these appear without anyone asking for them.
.settings/
.classpath
.project
.factorypath
bin/

# Personal Claude Code settings (the shared ones are tracked)
.claude/settings.local.json

# the safety net beside each file, never the record
*.backup-*
*.bak

# Python leaves this beside tools/world-report.py the first time it runs
__pycache__/

# Generated by tools/sightline-map.py - regenerate, do not commit
sightlines.html

# ---- worlds/ carries terrain, never people --------------------------------
# worlds/ is tracked on purpose and stays that way: it is the dev-world
# container, so a later hand can open any of these saves and check that a
# change did not break a world made before it. See worlds/README.md.
#
# What does NOT belong in it is anybody's player record. Each of these is
# keyed by, or contains, a Mojang account UUID - for whoever was playing,
# including LAN guests who never agreed to be in a public repository. None of
# it is needed to open a world: Minecraft rebuilds all four on load.
worlds/**/playerdata/
worlds/**/advancements/
worlds/**/stats/
worlds/**/usercache.json
worlds/**/usernamecache.json

# Bare, so it matches at any depth, and that is deliberate here where /build/
# is rooted. AGENTS.md IV: Minecraft holds this file open, and a stale lock
# restored into a world makes Minecraft REFUSE TO OPEN IT. A tracked one is a
# world that arrives broken in every clone.
session.lock
