{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["ObviousThr33s", "Serenity Crew"],
  "contact": {
    "sources": "${mod_sources}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["${mod_entrypoint}"],
    "client": ["${mod_package}.client.OctiaClient"],
    "fabric-gametest": [
      "${mod_package}.gametest.AndesiteFramePanelGameTest",
      "${mod_package}.gametest.ShipGameTest",
      "${mod_package}.gametest.OctiaWorldGameTest"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
